# Copy to .env on the VPS (docker-compose reads it via env_file). NEVER commit real values.

# Required by spring.mail.password
RESEND_API_KEY=

# Optional. When true, registration creates test accounts (skips email
# validation + OTP + email send; account marked is_test=true + verified).
# Off by default — leave unset/false.
ALLOW_TEST_ACCOUNTS=false

# Admin panel shared secret — REQUIRED, min 32 chars, long random string.
# Sent as the X-Admin-Key header to /api/admin/** endpoints.
# Blank/absent = admin endpoints fail closed with 503.
ADMIN_KEY=

# Database credentials. SPRING_DATASOURCE_PASSWORD (backend) and
# POSTGRES_PASSWORD (db service) MUST be the same value.
# Generate a strong one with:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
SPRING_DATASOURCE_PASSWORD=
POSTGRES_PASSWORD=
