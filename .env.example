# Copy to .env on the VPS (docker-compose reads it via env_file). NEVER commit real values.

# Required by spring.mail.password
RESEND_API_KEY=

# Admin panel shared secret — REQUIRED, min 32 chars, long random string.
# Sent as the X-Admin-Key header to /api/admin/** endpoints.
# Blank/absent = admin endpoints fail closed with 503.
ADMIN_KEY=
